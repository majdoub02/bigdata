# ===== Copier ce fichier en .env puis adapter les valeurs =====
# Ne JAMAIS versionner le fichier .env (secrets).

# Version de la stack Elastic (Elasticsearch, Logstash, Kibana)
ELK_VERSION=8.15.3
# Mémoire JVM d'Elasticsearch (1g conseillé en développement)
ES_HEAP=1g

# MongoDB
MONGO_USER=admin
MONGO_PASSWORD=change_me_mongo
MONGO_DB=seclog

# Redis
REDIS_PASSWORD=change_me_redis

# Application Flask
SECRET_KEY=change_me_secret_key
MAX_UPLOAD_MB=100
LOG_LEVEL=INFO
